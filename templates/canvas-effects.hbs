<div class="standard-form churas-canvas-effects-controls">
  <div class="form-group">
    <label for="churas-canvas-effect-source">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Source"}}</label>
    <div class="form-fields">
      <input id="churas-canvas-effect-source" type="text" data-effect-source placeholder="effects/earthquake.webm">
      <button type="button" data-action="browse" title="{{localize 'CHURAS_LITTLE_FIXES.CanvasEffects.Browse'}}">
        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <div class="form-group">
    <div class="form-fields">
      <button type="button" data-action="play">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Play"}}</button>
      <button type="button" data-action="stop">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Stop"}}</button>
      <button type="button" data-action="shake">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Shake"}}</button>
    </div>
  </div>
</div>
