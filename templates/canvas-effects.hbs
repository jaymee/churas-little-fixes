<div class="standard-form churas-canvas-effects-controls">
  <div class="form-group">
    <label for="churas-canvas-effect-source">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Source"}}</label>
    <div class="form-fields">
      <input id="churas-canvas-effect-source" type="text" data-effect-source value="{{source}}" placeholder="effects/earthquake.webm">
      <button type="button" data-action="browse" title="{{localize 'CHURAS_LITTLE_FIXES.CanvasEffects.Browse'}}">
        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <div class="form-group">
    <label for="churas-canvas-effect-loop">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Loop"}}</label>
    <div class="form-fields">
      <input id="churas-canvas-effect-loop" type="checkbox" data-effect-loop {{checked loop}}>
    </div>
  </div>
  <div class="form-group">
    <div class="form-fields">
      <button type="button" data-action="play">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Play"}}</button>
      <button type="button" data-action="stop">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Stop"}}</button>
    </div>
  </div>
  <div class="form-group">
    <label for="churas-canvas-shake-intensity">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Intensity"}}</label>
    <div class="form-fields">
      <input id="churas-canvas-shake-intensity" type="number" min="10" max="200" step="10" value="{{intensity}}" data-shake-intensity>
      <button type="button" data-action="shake">{{localize "CHURAS_LITTLE_FIXES.CanvasEffects.Shake"}}</button>
    </div>
  </div>
</div>
